@@ -0,0 +1,30 @@
+/* Opt-in research frame-age probe, not part of the production patch. */
+#ifndef FFTOOLS_FRAME_AGE_PROBE_H
+#define FFTOOLS_FRAME_AGE_PROBE_H
+#include <stdint.h>
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+typedef struct G2FrameAge {
+    int64_t frequency, sequence, present, sample, acquire_start, acquire_end, emit;
+    int64_t accumulated, mouse, flags;
+    int64_t filter_out, dequeue, encode_start, packet_ready;
+} G2FrameAge;
+
+static inline int64_t g2_age_qpc(void)
+{
+#ifdef _WIN32
+    LARGE_INTEGER value;
+    return QueryPerformanceCounter(&value) ? value.QuadPart : 0;
+#else
+    return 0;
+#endif
+}
+
+struct AVFrame;
+void g2_age_from_frame(G2FrameAge *age, const struct AVFrame *frame);
+void g2_age_record(const G2FrameAge *age, int64_t mux_start, int64_t mux_end,
+                   int bytes, int result, int output, int stream, int64_t pts);
+void g2_age_dump(void);
+#endif
