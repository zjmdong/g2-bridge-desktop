+/* This independent research build exports numeric records only after workers
+ * have stopped. Opaque FrameData ownership remains entirely with fftools. */
+#define G2AGE_MAX_RECORDS 16384
+typedef struct G2AgeRecord {
+    G2FrameAge age;
+    int64_t mux_start, mux_end, pts;
+    int bytes, result, output, stream;
+} G2AgeRecord;
+static G2AgeRecord g2_age_records[G2AGE_MAX_RECORDS];
+static atomic_uint g2_age_count;
+
+void g2_age_from_frame(G2FrameAge *age, const AVFrame *frame)
+{
+    const AVDictionaryEntry *entry = av_dict_get(frame->metadata, "g2.frame_age", NULL, 0);
+    G2FrameAge value = { 0 };
+    if (!entry)
+        return;
+    if (sscanf(entry->value,
+        "v1,%"SCNd64",%"SCNd64",%"SCNd64",%"SCNd64",%"SCNd64",%"SCNd64",%"SCNd64",%"SCNd64",%"SCNd64",%"SCNd64,
+        &value.frequency, &value.sequence, &value.present, &value.sample,
+        &value.acquire_start, &value.acquire_end, &value.emit,
+        &value.accumulated, &value.mouse, &value.flags) != 10 ||
+        value.frequency <= 0 || value.sequence <= 0 || value.sample <= 0 || value.emit < value.sample) {
+        av_log(NULL, AV_LOG_ERROR, "G2AGE malformed frame provenance\n");
+        memset(age, 0, sizeof(*age));
+        return;
+    }
+    value.filter_out = g2_age_qpc();
+    *age = value;
+}
+
+void g2_age_record(const G2FrameAge *age, int64_t mux_start, int64_t mux_end,
+                   int bytes, int result, int output, int stream, int64_t pts)
+{
+    unsigned index;
+    if (!age->sequence)
+        return;
+    index = atomic_fetch_add_explicit(&g2_age_count, 1, memory_order_relaxed);
+    if (index < G2AGE_MAX_RECORDS)
+        g2_age_records[index] = (G2AgeRecord){ *age, mux_start, mux_end, pts,
+                                             bytes, result, output, stream };
+}
+
+void g2_age_dump(void)
+{
+    unsigned count = atomic_load_explicit(&g2_age_count, memory_order_relaxed);
+    if (!count)
+        return;
+    fprintf(stderr, "G2AGE_HEADER version=1 records=%u capacity=%u dropped=%u\n",
+            count, G2AGE_MAX_RECORDS, count > G2AGE_MAX_RECORDS ? count - G2AGE_MAX_RECORDS : 0);
+    for (unsigned i = 0; i < FFMIN(count, G2AGE_MAX_RECORDS); ++i) {
+        const G2AgeRecord *r = &g2_age_records[i];
+        const G2FrameAge *a = &r->age;
+        fprintf(stderr,
+          "G2AGE_RECORD index=%u frequency=%"PRId64" sequence=%"PRId64
+          " present=%"PRId64" sample=%"PRId64" acquire_start=%"PRId64
+          " acquire_end=%"PRId64" emit=%"PRId64" accumulated=%"PRId64
+          " mouse=%"PRId64" flags=%"PRId64" filter_out=%"PRId64
+          " dequeue=%"PRId64" encode_start=%"PRId64" packet_ready=%"PRId64
+          " mux_start=%"PRId64" mux_end=%"PRId64" pts=%"PRId64
+          " bytes=%d result=%d output=%d stream=%d\n",
+          i, a->frequency, a->sequence, a->present, a->sample,
+          a->acquire_start, a->acquire_end, a->emit, a->accumulated, a->mouse,
+          a->flags, a->filter_out, a->dequeue, a->encode_start, a->packet_ready,
+          r->mux_start, r->mux_end, r->pts, r->bytes, r->result, r->output, r->stream);
+    }
+    fprintf(stderr, "G2AGE_END records=%u\n", FFMIN(count, G2AGE_MAX_RECORDS));
+}
