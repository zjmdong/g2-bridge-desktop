+/*
+ * Optional, per-thread Windows capture scheduling.
+ * This file is part of FFmpeg, licensed under the GNU LGPL version 2.1 or later.
+ */
+#ifndef FFTOOLS_WIN_MMCSS_H
+#define FFTOOLS_WIN_MMCSS_H
+
+#ifdef _WIN32
+#include <windows.h>
+#include <avrt.h>
+
+typedef HANDLE (WINAPI *MmcssRegister)(LPCWSTR, LPDWORD);
+typedef BOOL (WINAPI *MmcssPriority)(HANDLE, AVRT_PRIORITY);
+typedef BOOL (WINAPI *MmcssRevert)(HANDLE);
+
+typedef struct WinMmcssState {
+    HMODULE module;
+    HANDLE registration;
+    MmcssRevert revert;
+} WinMmcssState;
+
+/* Called only by the worker that will own and later revert this registration.
+ * No registry, system power, process priority, or GPU policy is changed. */
+static inline DWORD win_mmcss_begin(WinMmcssState *state)
+{
+    MmcssRegister register_task;
+    MmcssPriority set_priority;
+    DWORD task_index = 0;
+    DWORD error;
+
+    state->module = LoadLibraryExW(L"avrt.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    if (!state->module)
+        return GetLastError();
+    register_task = (MmcssRegister)GetProcAddress(state->module, "AvSetMmThreadCharacteristicsW");
+    set_priority = (MmcssPriority)GetProcAddress(state->module, "AvSetMmThreadPriority");
+    state->revert = (MmcssRevert)GetProcAddress(state->module, "AvRevertMmThreadCharacteristics");
+    if (!register_task || !set_priority || !state->revert) {
+        error = ERROR_PROC_NOT_FOUND;
+        goto fail;
+    }
+    state->registration = register_task(L"Capture", &task_index);
+    if (!state->registration) {
+        error = GetLastError();
+        goto fail;
+    }
+    /* A failed priority adjustment leaves a valid registration that must still
+     * be reverted; the caller may continue with the task's default priority. */
+    if (!set_priority(state->registration, AVRT_PRIORITY_HIGH))
+        return GetLastError();
+    return ERROR_SUCCESS;
+
+fail:
+    FreeLibrary(state->module);
+    state->module = NULL;
+    state->revert = NULL;
+    return error;
+}
+
+static inline DWORD win_mmcss_end(WinMmcssState *state)
+{
+    DWORD error = ERROR_SUCCESS;
+    if (state->registration && !state->revert(state->registration))
+        error = GetLastError();
+    state->registration = NULL;
+    if (state->module)
+        FreeLibrary(state->module);
+    state->module = NULL;
+    state->revert = NULL;
+    return error;
+}
+#endif
+#endif
