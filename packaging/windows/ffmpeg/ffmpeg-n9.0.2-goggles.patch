diff --git a/fftools/frame_pacing.h b/fftools/frame_pacing.h
new file mode 100644
--- /dev/null
+++ b/fftools/frame_pacing.h
@@ -0,0 +1,35 @@
+/*
+ * Helpers for opt-in live raw-frame pacing.
+ * This file is part of FFmpeg, licensed under the GNU LGPL version 2.1 or later.
+ */
+#ifndef FFTOOLS_FRAME_PACING_H
+#define FFTOOLS_FRAME_PACING_H
+
+#include <stdint.h>
+
+#include "libavutil/error.h"
+#include "libavutil/frame.h"
+#include "libavutil/mathematics.h"
+
+/* Called only after a frame leaves the raw mailbox. Compact timestamps prevent
+ * AVI gap-fill packets; they are not measurements of capture or wall-clock age.
+ * Pixel buffers and source-specific frame metadata are deliberately untouched. */
+static inline int frame_pacing_compact(AVFrame *frame, uint64_t index, AVRational rate)
+{
+    int64_t pts, next;
+
+    if (index >= INT64_MAX || rate.num <= 0 || rate.den <= 0 ||
+        frame->time_base.num <= 0 || frame->time_base.den <= 0)
+        return AVERROR(EINVAL);
+
+    pts  = av_rescale_q(index,     av_inv_q(rate), frame->time_base);
+    next = av_rescale_q(index + 1, av_inv_q(rate), frame->time_base);
+    if (pts < 0 || next <= pts)
+        return AVERROR(EINVAL);
+
+    frame->pts = pts;
+    frame->duration = next - pts;
+    return 0;
+}
+
+#endif
diff --git a/fftools/tests/run_mailbox_test.ps1 b/fftools/tests/run_mailbox_test.ps1
new file mode 100644
--- /dev/null
+++ b/fftools/tests/run_mailbox_test.ps1
@@ -0,0 +1,37 @@
+param(
+    [Parameter(Mandatory = $true)][string]$BuildDirectory,
+    [Parameter(Mandatory = $true)][string]$Compiler
+)
+
+$ErrorActionPreference = 'Stop'
+$sourceRoot = (Resolve-Path -LiteralPath (Join-Path $PSScriptRoot '../..')).Path
+$buildRoot = (Resolve-Path -LiteralPath $BuildDirectory).Path
+$compilerPath = (Resolve-Path -LiteralPath $Compiler).Path
+$testBinary = Join-Path $buildRoot 'thread_queue_mailbox.exe'
+$savedPath = $env:PATH
+
+try {
+    $env:PATH = (Split-Path -Parent $compilerPath) + ';' + $savedPath
+    $compilerArguments = @(
+        '-std=c17', '-O2', '-Wall', '-Wextra', '-Werror',
+        '-Wno-unused-parameter', '-Wno-cast-function-type',
+        '-U__STRICT_ANSI__', '-DWIN32_LEAN_AND_MEAN',
+        "-I$buildRoot", "-I$sourceRoot",
+        (Join-Path $PSScriptRoot 'thread_queue_mailbox.c'),
+        (Join-Path $sourceRoot 'fftools/thread_queue.c'),
+        (Join-Path $buildRoot 'libavcodec/libavcodec.a'),
+        (Join-Path $buildRoot 'libavutil/libavutil.a'),
+        '-static', '-lm', '-luser32', '-lbcrypt', '-latomic', '-lole32', '-lwinmm',
+        '-o', $testBinary
+    )
+    & $compilerPath @compilerArguments
+    if ($LASTEXITCODE -ne 0) {
+        throw "Mailbox test compilation failed with exit code $LASTEXITCODE"
+    }
+    & $testBinary
+    if ($LASTEXITCODE -ne 0) {
+        throw "Mailbox test failed with exit code $LASTEXITCODE"
+    }
+} finally {
+    $env:PATH = $savedPath
+}
diff --git a/fftools/tests/thread_queue_mailbox.c b/fftools/tests/thread_queue_mailbox.c
new file mode 100644
--- /dev/null
+++ b/fftools/tests/thread_queue_mailbox.c
@@ -0,0 +1,314 @@
+/*
+ * Tests the real fftools/thread_queue.c and frame_pacing.h, without a GPU.
+ * This file is part of FFmpeg, licensed under the GNU LGPL version 2.1 or later.
+ */
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#include "fftools/thread_queue.h"
+#include "fftools/frame_pacing.h"
+#include "libavcodec/packet.h"
+#include "libavutil/avassert.h"
+#include "libavutil/buffer.h"
+#include "libavutil/mem.h"
+#include "libavutil/thread.h"
+
+#define MAX_FRAMES 30000
+#define STRESS_FRAMES 10000
+
+typedef struct ReleaseRecord {
+    atomic_int count;
+    int id;
+} ReleaseRecord;
+
+static ReleaseRecord records[MAX_FRAMES];
+static atomic_int created;
+
+static void release_pixels(void *opaque, uint8_t *data)
+{
+    ReleaseRecord *record = opaque;
+    av_assert0(*(int *)data == record->id);
+    av_assert0(atomic_fetch_add(&record->count, 1) == 0);
+    av_free(data);
+}
+
+static AVFrame *new_frame(void)
+{
+    AVFrame *frame = av_frame_alloc();
+    int id = atomic_fetch_add(&created, 1);
+    uint8_t *pixels;
+
+    av_assert0(frame && id < MAX_FRAMES);
+    records[id].id = id;
+    pixels = av_malloc(sizeof(int));
+    av_assert0(pixels);
+    *(int *)pixels = id;
+    frame->buf[0] = av_buffer_create(pixels, sizeof(int), release_pixels, &records[id], 0);
+    av_assert0(frame->buf[0]);
+    frame->data[0] = pixels;
+    frame->linesize[0] = 2;
+    frame->format = AV_PIX_FMT_GRAY8;
+    frame->width = frame->height = 2;
+    frame->pts = id;
+    frame->time_base = (AVRational){ 1, 100 };
+    frame->duration = 1;
+    return frame;
+}
+
+static ThreadQueue *mailbox(void)
+{
+    ThreadQueue *queue = tq_alloc(1, 1, THREAD_QUEUE_FRAMES);
+    av_assert0(queue && tq_set_latest_frame(queue) == 0);
+    return queue;
+}
+
+static int send_new(ThreadQueue *queue)
+{
+    AVFrame *frame = new_frame();
+    int id = frame->pts;
+    av_assert0(tq_send(queue, 0, frame) == 0);
+    av_assert0(!frame->buf[0]);
+    av_frame_free(&frame);
+    return id;
+}
+
+static int receive_id(ThreadQueue *queue, AVFrame *frame)
+{
+    int stream;
+    av_assert0(tq_receive(queue, &stream, frame, 0) == 0);
+    av_assert0(stream == 0 && frame->buf[0]);
+    av_assert0(*(int *)frame->data[0] == frame->pts);
+    return frame->pts;
+}
+
+static void test_replacement_ownership_and_eof(void)
+{
+    ThreadQueue *queue = mailbox();
+    AVFrame *held = av_frame_alloc(), *out = av_frame_alloc(), *rejected;
+    AVBufferRef *extra;
+    int first = send_new(queue), second, third, fourth, stream;
+
+    av_assert0(held && out);
+    av_assert0(receive_id(queue, held) == first);
+    extra = av_buffer_ref(held->buf[0]);
+    av_assert0(extra);
+    second = send_new(queue);
+    third = send_new(queue);
+    fourth = send_new(queue);
+    av_assert0(tq_latest_frame_dropped(queue) == 2);
+    av_assert0(atomic_load(&records[second].count) == 1);
+    av_assert0(atomic_load(&records[third].count) == 1);
+    av_assert0(atomic_load(&records[first].count) == 0);
+    av_assert0(*(int *)held->data[0] == first); // no overwrite of in-flight pixels
+
+    tq_send_finish(queue, 0);
+    rejected = new_frame();
+    av_assert0(tq_send(queue, 0, rejected) == AVERROR(EINVAL));
+    av_assert0(rejected->buf[0]);
+    av_frame_free(&rejected);
+    av_assert0(receive_id(queue, out) == fourth); // final data precedes EOF
+    av_frame_unref(out);
+    av_assert0(tq_receive(queue, &stream, out, 0) == AVERROR_EOF && stream == 0);
+    av_assert0(tq_receive(queue, &stream, out, 0) == AVERROR_EOF && stream == -1);
+    av_frame_free(&out);
+    av_frame_free(&held);
+    av_assert0(atomic_load(&records[first].count) == 0);
+    av_buffer_unref(&extra);
+    av_assert0(atomic_load(&records[first].count) == 1);
+    tq_free(&queue);
+}
+
+static void test_empty_eof_consumer_finish_and_choke(void)
+{
+    ThreadQueue *queue = mailbox();
+    AVFrame *out = av_frame_alloc(), *rejected;
+    int stream, pending, latest;
+
+    av_assert0(out);
+    tq_send_finish(queue, 0);
+    av_assert0(tq_receive(queue, &stream, out, 0) == AVERROR_EOF && stream == 0);
+    av_assert0(tq_set_latest_frame(queue) == AVERROR(EINVAL));
+    tq_free(&queue);
+
+    queue = mailbox();
+    pending = send_new(queue);
+    tq_receive_finish(queue, 0);
+    rejected = new_frame();
+    av_assert0(tq_send(queue, 0, rejected) == AVERROR_EOF);
+    av_assert0(rejected->buf[0]);
+    av_frame_free(&rejected);
+    av_assert0(tq_receive(queue, &stream, out, THREAD_QUEUE_FLAG_NO_BLOCK) == AVERROR_EOF);
+    av_assert0(atomic_load(&records[pending].count) == 1);
+    av_assert0(tq_latest_frame_dropped(queue) == 0); // EOF cleanup is not replacement
+    tq_free(&queue);
+
+    queue = mailbox();
+    tq_choke(queue, 1);
+    send_new(queue);
+    latest = send_new(queue);
+    av_assert0(tq_receive(queue, &stream, out, THREAD_QUEUE_FLAG_NO_BLOCK) == AVERROR(EAGAIN));
+    tq_send_finish(queue, 0); // EOF must unchoke and deliver the final frame
+    av_assert0(receive_id(queue, out) == latest);
+    av_frame_unref(out);
+    av_assert0(tq_receive(queue, &stream, out, 0) == AVERROR_EOF);
+    av_assert0(tq_latest_frame_dropped(queue) == 1);
+    tq_free(&queue);
+    av_frame_free(&out);
+}
+
+static void test_default_and_rejected_modes(void)
+{
+    ThreadQueue *queue = tq_alloc(1, 2, THREAD_QUEUE_FRAMES);
+    AVFrame *out = av_frame_alloc(), *invalid;
+    AVPacket *packet = av_packet_alloc(), *received = av_packet_alloc();
+    int a, b, stream;
+
+    av_assert0(queue && out && packet && received);
+    av_assert0(tq_set_latest_frame(queue) == AVERROR(EINVAL));
+    a = send_new(queue);
+    b = send_new(queue);
+    av_assert0(receive_id(queue, out) == a);
+    av_frame_unref(out);
+    av_assert0(receive_id(queue, out) == b);
+    av_frame_unref(out);
+    av_assert0(tq_latest_frame_dropped(queue) == 0);
+    tq_free(&queue);
+
+    queue = tq_alloc(2, 1, THREAD_QUEUE_FRAMES);
+    av_assert0(queue && tq_set_latest_frame(queue) == AVERROR(EINVAL));
+    tq_free(&queue);
+    queue = tq_alloc(1, 1, THREAD_QUEUE_PACKETS);
+    av_assert0(queue && tq_set_latest_frame(queue) == AVERROR(EINVAL));
+    av_assert0(av_new_packet(packet, 1) == 0);
+    packet->data[0] = 42;
+    av_assert0(tq_send(queue, 0, packet) == 0);
+    av_assert0(tq_receive(queue, &stream, received, 0) == 0);
+    av_assert0(received->data[0] == 42 && tq_latest_frame_dropped(queue) == 0);
+    tq_free(&queue);
+    av_packet_free(&packet);
+    av_packet_free(&received);
+
+    queue = mailbox();
+    invalid = new_frame();
+    invalid->nb_samples = 1; // audio/control-shaped data must never be replaced
+    av_assert0(tq_send(queue, 0, invalid) == AVERROR(EINVAL));
+    av_assert0(invalid->buf[0]);
+    av_frame_free(&invalid);
+    a = send_new(queue);
+    tq_free(&queue); // undelivered raw reference released on teardown
+    av_assert0(atomic_load(&records[a].count) == 1);
+    av_frame_free(&out);
+}
+
+typedef struct Stress {
+    ThreadQueue *queue;
+    pthread_mutex_t lock;
+    pthread_cond_t cond;
+    int gate;
+    unsigned received;
+    int last;
+} Stress;
+
+static void *producer(void *opaque)
+{
+    Stress *s = opaque;
+    for (unsigned i = 0; i < STRESS_FRAMES; i++) {
+        send_new(s->queue);
+        if (i == 99) {
+            pthread_mutex_lock(&s->lock);
+            s->gate = 1;
+            pthread_cond_broadcast(&s->cond);
+            pthread_mutex_unlock(&s->lock);
+        }
+    }
+    tq_send_finish(s->queue, 0);
+    return NULL;
+}
+
+static void *consumer(void *opaque)
+{
+    Stress *s = opaque;
+    AVFrame *out = av_frame_alloc();
+    int stream, ret;
+    av_assert0(out);
+    pthread_mutex_lock(&s->lock);
+    while (!s->gate)
+        pthread_cond_wait(&s->cond, &s->lock);
+    pthread_mutex_unlock(&s->lock);
+
+    while ((ret = tq_receive(s->queue, &stream, out, 0)) == 0) {
+        av_assert0(stream == 0 && out->pts > s->last);
+        av_assert0(*(int *)out->data[0] == out->pts);
+        s->last = out->pts;
+        s->received++;
+        av_frame_unref(out);
+    }
+    av_assert0(ret == AVERROR_EOF);
+    av_frame_free(&out);
+    return NULL;
+}
+
+static void test_concurrent_overwrite(void)
+{
+    Stress s = { .queue = mailbox(), .last = -1 };
+    pthread_t producer_thread, consumer_thread;
+    int start = atomic_load(&created);
+    uint64_t replaced;
+    av_assert0(pthread_mutex_init(&s.lock, NULL) == 0);
+    av_assert0(pthread_cond_init(&s.cond, NULL) == 0);
+    av_assert0(pthread_create(&consumer_thread, NULL, consumer, &s) == 0);
+    av_assert0(pthread_create(&producer_thread, NULL, producer, &s) == 0);
+    av_assert0(pthread_join(producer_thread, NULL) == 0);
+    av_assert0(pthread_join(consumer_thread, NULL) == 0);
+    replaced = tq_latest_frame_dropped(s.queue);
+    av_assert0(replaced >= 99);
+    av_assert0(replaced + s.received == STRESS_FRAMES);
+    av_assert0(s.last == start + STRESS_FRAMES - 1);
+    tq_free(&s.queue);
+    pthread_cond_destroy(&s.cond);
+    pthread_mutex_destroy(&s.lock);
+}
+
+static void test_compact_timestamps(void)
+{
+    AVFrame *frame = new_frame();
+    int original_id = *(int *)frame->data[0];
+    int64_t end = 0;
+
+    for (unsigned i = 0; i < 1000; i++) {
+        frame->pts = 10000 + i * 3; // source IDs/PTS gaps must not create AVI holes
+        av_assert0(frame_pacing_compact(frame, i, (AVRational){ 100, 1 }) == 0);
+        av_assert0(frame->pts == i && frame->duration == 1);
+        av_assert0(*(int *)frame->data[0] == original_id);
+    }
+    frame->time_base = (AVRational){ 1, 1000 };
+    for (unsigned i = 0; i < 75; i++) {
+        av_assert0(frame_pacing_compact(frame, i, (AVRational){ 75, 1 }) == 0);
+        av_assert0(frame->pts == end && frame->duration > 0);
+        end = frame->pts + frame->duration;
+    }
+    av_assert0(end == 1000);
+    frame->time_base = (AVRational){ 1, 90000 };
+    av_assert0(frame_pacing_compact(frame, 100, (AVRational){ 30000, 1001 }) == 0);
+    av_assert0(frame->pts == 300300 && frame->duration == 3003);
+    av_assert0(frame_pacing_compact(frame, UINT64_MAX, (AVRational){ 100, 1 }) < 0);
+    av_assert0(frame_pacing_compact(frame, 0, (AVRational){ 0, 1 }) < 0);
+    frame->time_base = (AVRational){ 1, 1 };
+    av_assert0(frame_pacing_compact(frame, 0, (AVRational){ 100, 1 }) < 0);
+    av_frame_free(&frame);
+}
+
+int main(void)
+{
+    test_replacement_ownership_and_eof();
+    test_empty_eof_consumer_finish_and_choke();
+    test_default_and_rejected_modes();
+    test_concurrent_overwrite();
+    test_compact_timestamps();
+    for (int i = 0; i < atomic_load(&created); i++)
+        av_assert0(atomic_load(&records[i].count) == 1);
+    printf("PASS: real thread_queue mailbox, FIFO compatibility, EOF, references, concurrency, compact PTS (%d frames released exactly once)\n",
+           atomic_load(&created));
+    return 0;
+}
