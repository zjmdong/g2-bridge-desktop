+/* Opt-in DDA frames carry an absolute deadline through COPY_OPAQUE. Waiting in
+ * this thread leaves capture/encode independent and keeps the existing bounded
+ * packet queue. This holds the current packet, never drops/reorders a reference
+ * picture, and never shifts future deadlines to compensate for a late packet. */
+static int mux_delivery_wait(Muxer *mux, const AVPacket *pkt)
+{
+    const FrameData *fd = pkt->opaque_ref ? (const FrameData *)pkt->opaque_ref->data : NULL;
+    if (!fd || !fd->delivery.frequency)
+        return 0;
+#ifdef _WIN32
+    {
+        LARGE_INTEGER value;
+        int64_t remaining, spin, arrival, deadline;
+        int did_wait;
+        if (!mux->delivery_timer) {
+            if (!QueryPerformanceFrequency(&value) || value.QuadPart <= 0)
+                return AVERROR_EXTERNAL;
+            mux->delivery_frequency = value.QuadPart;
+            mux->delivery_timer = CreateWaitableTimerExW(NULL, NULL,
+                    CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_MODIFY_STATE | SYNCHRONIZE);
+            if (!mux->delivery_timer) {
+                av_log(mux, AV_LOG_ERROR, "Could not create source delivery deadline timer\n");
+                return AVERROR_EXTERNAL;
+            }
+        }
+        if (!QueryPerformanceCounter(&value))
+            return AVERROR_EXTERNAL;
+        remaining = g2_delivery_remaining(&fd->delivery, mux->delivery_frequency,
+                                           value.QuadPart);
+        if (remaining < 0) {
+            av_log(mux, AV_LOG_ERROR, "Invalid source delivery deadline or QPC clock\n");
+            return AVERROR(EINVAL);
+        }
+        arrival = value.QuadPart;
+        deadline = fd->delivery.source_deadline + fd->delivery.delay;
+        did_wait = remaining > 0;
+        mux->delivery_eligible++;
+        if (arrival > deadline) {
+            const int64_t late = arrival - deadline;
+            mux->delivery_arrival_late++;
+            mux->delivery_arrival_late_100us += late > mux->delivery_frequency / 10000;
+            mux->delivery_max_arrival_late = FFMAX(mux->delivery_max_arrival_late, late);
+        }
+        spin = mux->delivery_frequency / 10000; /* At most a 100 us spin tail. */
+        while (remaining > 0) {
+            if (int_cb.callback && int_cb.callback(int_cb.opaque))
+                return AVERROR_EXIT;
+            if (remaining > spin) {
+                LARGE_INTEGER due;
+                DWORD result;
+                /* Validation bounds remaining to <=20 ms and one source frame.
+                 * Relative timers use 100 ns units; QPC is the only clock used
+                 * for deciding whether the absolute delivery deadline passed. */
+                due.QuadPart = -(remaining - spin) * INT64_C(10000000) /
+                              mux->delivery_frequency;
