 #ifdef _WIN32
 #include <windows.h>
+#include <inttypes.h>
+#include <stdlib.h>
+#endif
+
+#ifdef _WIN32
+/* Temporary research instrumentation. No allocations, clocks, locks or I/O
+ * when disabled. Raw QPC ticks are converted only during the close summary. */
+#define NVENC_PHASE_CAPACITY 8192
+enum NvencPhase {
+    PHASE_UPLOAD, PHASE_SUBMIT, PHASE_EVENT, PHASE_LOCK, PHASE_COPY,
+    PHASE_UNLOCK, PHASE_UNMAP, PHASE_TOTAL, PHASE_GAP, PHASE_COUNT
+};
+typedef struct NvencPhaseRow {
+    int64_t start, pts;
+    uint64_t frame;
+    int64_t elapsed[PHASE_COUNT];
+    unsigned mask, bytes, idr;
+} NvencPhaseRow;
+typedef struct NvencPhaseProfile {
+    int64_t frequency, previous_output;
+    uint64_t seen;
+    unsigned rows;
+    NvencPhaseRow row[NVENC_PHASE_CAPACITY];
+    int64_t scratch[NVENC_PHASE_CAPACITY];
+} NvencPhaseProfile;
+
+static inline int64_t nvenc_phase_clock(NvencContext *ctx)
+{
+    LARGE_INTEGER now;
+    if (!ctx->phase_profile)
+        return 0;
+    QueryPerformanceCounter(&now);
+    return now.QuadPart;
+}
+
+static void nvenc_phase_begin(NvencContext *ctx, NvencSurface *surface, const AVFrame *frame)
+{
+    NvencPhaseProfile *profile = ctx->phase_profile;
+    NvencPhaseRow *row;
+    surface->phase_index = -1;
+    if (!profile)
+        return;
+    profile->seen++;
+    if (profile->rows == NVENC_PHASE_CAPACITY)
+        return;
+    surface->phase_index = profile->rows++;
+    row = &profile->row[surface->phase_index];
+    row->start = nvenc_phase_clock(ctx);
+    row->frame = ctx->frame_idx_counter;
+    row->pts = frame->pts;
+}
+
+static void nvenc_phase_record(NvencContext *ctx, NvencSurface *surface,
+                               enum NvencPhase phase, int64_t start)
+{
+    NvencPhaseProfile *profile = ctx->phase_profile;
+    if (profile && surface->phase_index >= 0) {
+        NvencPhaseRow *row = &profile->row[surface->phase_index];
+        row->elapsed[phase] = nvenc_phase_clock(ctx) - start;
+        row->mask |= 1U << phase;
+    }
+}
+
+static void nvenc_phase_complete(NvencContext *ctx, NvencSurface *surface,
+                                 const NV_ENC_LOCK_BITSTREAM *bitstream)
+{
+    NvencPhaseProfile *profile = ctx->phase_profile;
+    if (profile && surface->phase_index >= 0) {
+        NvencPhaseRow *row = &profile->row[surface->phase_index];
+        int64_t now = nvenc_phase_clock(ctx);
+        row->elapsed[PHASE_TOTAL] = now - row->start;
+        row->mask |= 1U << PHASE_TOTAL;
+        row->bytes = bitstream->bitstreamSizeInBytes;
+        row->idr = bitstream->pictureType == NV_ENC_PIC_TYPE_IDR;
+        if (profile->previous_output) {
+            row->elapsed[PHASE_GAP] = now - profile->previous_output;
+            row->mask |= 1U << PHASE_GAP;
+        }
+        profile->previous_output = now;
+    }
+}
+
+static int nvenc_phase_compare(const void *left, const void *right)
+{
+    int64_t a = *(const int64_t *)left, b = *(const int64_t *)right;
+    return (a > b) - (a < b);
+}
+
+static void nvenc_phase_report(AVCodecContext *avctx)
+{
+    static const char *names[PHASE_COUNT] = {
+        "upload_map", "submit", "event_wait", "lock", "alloc_copy",
+        "unlock", "unmap", "total", "output_gap"
+    };
+    NvencContext *ctx = avctx->priv_data;
+    NvencPhaseProfile *p = ctx->phase_profile;
+    unsigned completed = 0;
+    int top[8] = { -1, -1, -1, -1, -1, -1, -1, -1 };
+    double us;
+
+    if (!p)
+        return;
+    us = 1000000.0 / p->frequency;
+    for (unsigned i = 0; i < p->rows; i++) {
+        if (!(p->row[i].mask & (1U << PHASE_TOTAL)))
+            continue;
+        completed++;
+        for (unsigned j = 0; j < FF_ARRAY_ELEMS(top); j++) {
+            if (top[j] < 0 || p->row[i].elapsed[PHASE_TOTAL] > p->row[top[j]].elapsed[PHASE_TOTAL]) {
+                for (unsigned k = FF_ARRAY_ELEMS(top) - 1; k > j; k--)
+                    top[k] = top[k - 1];
+                top[j] = i;
+                break;
+            }
+        }
+    }
+    av_log(avctx, AV_LOG_INFO,
+           "NVENC_PHASE_SUMMARY seen=%"PRIu64" stored=%u completed=%u capacity=%d unit=us async=%d\n",
+           p->seen, p->rows, completed, NVENC_PHASE_CAPACITY, ctx->async_encode);
+    for (unsigned warmup = 0; warmup <= 100; warmup += 100) {
+        for (unsigned phase = 0; phase < PHASE_COUNT; phase++) {
+            unsigned count = 0, over1 = 0, over5 = 0;
+            double sum = 0;
+            for (unsigned i = warmup; i < p->rows; i++) {
+                NvencPhaseRow *row = &p->row[i];
+                int64_t value;
+                if (!(row->mask & (1U << PHASE_TOTAL)) || !(row->mask & (1U << phase)))
+                    continue;
+                value = row->elapsed[phase];
+                p->scratch[count++] = value;
+                sum += value;
+                over1 += value * us > 1000;
+                over5 += value * us > 5000;
+            }
+            if (!count)
+                continue;
+            qsort(p->scratch, count, sizeof(*p->scratch), nvenc_phase_compare);
+            av_log(avctx, AV_LOG_INFO,
+                   "NVENC_PHASE skip=%u name=%s n=%u mean=%.3f p50=%.3f p95=%.3f p99=%.3f max=%.3f gt1ms=%u gt5ms=%u\n",
+                   warmup, names[phase], count, sum * us / count,
+                   p->scratch[(count * 50 + 99) / 100 - 1] * us,
+                   p->scratch[(count * 95 + 99) / 100 - 1] * us,
+                   p->scratch[(count * 99 + 99) / 100 - 1] * us,
+                   p->scratch[count - 1] * us, over1, over5);
+        }
+    }
+    for (unsigned j = 0; j < FF_ARRAY_ELEMS(top) && top[j] >= 0; j++) {
+        NvencPhaseRow *r = &p->row[top[j]];
+        av_log(avctx, AV_LOG_INFO,
+               "NVENC_PHASE_SLOW frame=%"PRIu64" pts=%"PRId64" idr=%u bytes=%u total=%.3f upload=%.3f submit=%.3f event=%.3f lock=%.3f copy=%.3f unlock=%.3f unmap=%.3f gap=%.3f\n",
+               r->frame, r->pts, r->idr, r->bytes, r->elapsed[PHASE_TOTAL] * us,
+               r->elapsed[PHASE_UPLOAD] * us, r->elapsed[PHASE_SUBMIT] * us,
+               r->elapsed[PHASE_EVENT] * us, r->elapsed[PHASE_LOCK] * us,
+               r->elapsed[PHASE_COPY] * us, r->elapsed[PHASE_UNLOCK] * us,
+               r->elapsed[PHASE_UNMAP] * us, r->elapsed[PHASE_GAP] * us);
+    }
+    av_freep(&ctx->phase_profile);
+}
 #endif
 
