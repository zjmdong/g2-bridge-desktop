      "css": ".ds-primary {font-family:\"Microsoft YaHei UI\",\"Segoe UI\",sans-serif;background:#146b64;color:#fff;border:1px solid #146b64;border-radius:6px;padding:12px 28px;font-size:15px;font-weight:600;min-width:150px;cursor:pointer}.ds-primary:hover {background:#0e5852}.ds-primary:focus-visible {outline:2px solid #257b7b;outline-offset:2px}.ds-primary:disabled {background:#d9e3de;color:#526b66;border-color:#d9e3de;cursor:default}"
    },
    {
      "name": "Secondary Action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Native recovery or utility action with hover, pressed, disabled, and focus treatments.",
      "html": "<button class=\"ds-secondary\" type=\"button\">重新检测设备与环境</button>",
      "css": ".ds-secondary {font-family:\"Microsoft YaHei UI\",\"Segoe UI\",sans-serif;font-size:13px;color:#20363c;background:#fff;border:1px solid #b9cac9;border-radius:6px;padding:8px 14px;min-height:20px;cursor:pointer}.ds-secondary:hover {background:#edf4f1;border-color:#36706f}.ds-secondary:active {background:#daeae4}.ds-secondary:focus-visible {outline:2px solid #257b7b;outline-offset:2px}.ds-secondary:disabled {color:#7c898b;background:#edf0ec;border-color:#d7dfda;cursor:default}"
    },
    {
      "name": "Labeled Native Selector",
      "kind": "input",
      "refersTo": "combobox",
      "description": "HTML approximation of QComboBox with the exact original SVG chevron geometry. Four basic selectors have matching visible and accessible names; resolution stays disabled.",
      "html": "<label class=\"ds-field\">画质预设<span class=\"ds-select-wrap\"><select class=\"ds-select\" aria-label=\"画质预设\"><option>均衡 · 推荐</option><option>画质优先</option><option>节省带宽</option><option>自定义</option></select><svg class=\"ds-chevron\" aria-hidden=\"true\" width=\"14\" height=\"10\" viewBox=\"0 0 14 10\"><path d=\"M2 3l5 5 5-5\" fill=\"none\" stroke=\"#36706f\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></label>",
      "css": ".ds-field {font-family:\"Microsoft YaHei UI\",\"Segoe UI\",sans-serif;display:block;color:#526a70;font-size:12px;max-width:392px}.ds-select-wrap {position:relative;display:block;margin-top:9px}.ds-select {font-family:\"Microsoft YaHei UI\",\"Segoe UI\",sans-serif;font-size:13px;color:#20363c;appearance:none;width:100%;background:#fff;border:1px solid #b9cac9;border-radius:6px;padding:9px 38px 9px 12px;min-height:38px}.ds-select:focus-visible {outline:2px solid #257b7b;outline-offset:1px}.ds-select:disabled {color:#53666a;background:#f0f3ef}.ds-chevron {position:absolute;right:13px;top:50%;transform:translateY(-50%);pointer-events:none}"
    },
    {
      "name": "Petrol Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "The fixed native rail contains three checkable page buttons. Selection uses stronger teal, white text, and semibold weight.",
      "html": "<nav class=\"ds-nav\" aria-label=\"主要导航\"><button class=\"ds-nav-item ds-nav-selected\" aria-current=\"page\" type=\"button\">桌面串流</button><button class=\"ds-nav-item\" type=\"button\">设备与驱动</button><button class=\"ds-nav-item\" type=\"button\">帮助与诊断</button></nav>",
      "css": ".ds-nav {background:#153f46;padding:20px;width:160px;display:grid;gap:8px}.ds-nav-item {font-family:\"Microsoft YaHei UI\",\"Segoe UI\",sans-serif;background:transparent;color:#d4e4e3;text-align:left;border:0;border-radius:6px;font-size:14px;padding:12px 16px;cursor:pointer}.ds-nav-item:hover {background:#24515a}.ds-nav-item.ds-nav-selected {background:#32646a;color:#fff;font-weight:600}.ds-nav-item:focus-visible {outline:2px solid #257b7b;outline-offset:2px}"
    },
    {
      "name": "Content Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat bordered native panel with 22px horizontal and 18px vertical inset. Static content has no fabricated hover behavior.",
      "html": "<section class=\"ds-panel\"><h3 class=\"ds-panel-heading\">电脑桌面</h3><p class=\"ds-panel-copy\">串流 SDK 默认显示器（索引 0）的完整画面。</p><p class=\"ds-panel-small\">本版仅支持桌面来源；窗口选择与独立扩展桌面将在后续版本提供。</p></section>",
      "css": ".ds-panel {font-family:\"Microsoft YaHei UI\",\"Segoe UI\",sans-serif;font-size:13px;color:#20363c;background:#fff;border:1px solid #d7e1de;border-radius:10px;padding:18px 22px;display:grid;gap:12px}.ds-panel-heading {font-size:16px;font-weight:600;margin:0}.ds-panel-copy {color:#526a70;margin:0}.ds-panel-small {color:#526a70;font-size:12px;margin:0}"
    },
    {
      "name": "Readiness Summary",
      "kind": "custom",
      "refersTo": "readiness",
      "description": "Evidence-backed title and explanatory text above three muted checkpoint labels. Amber title reflects a missing setup step; checkpoints do not change color in this build.",
      "html": "<section class=\"ds-readiness\" aria-label=\"连接状态\"><h3 class=\"ds-status\">还需要准备 USB 驱动</h3><p class=\"ds-detail\">前往「设备与驱动」，安装 SDK 已验证的 DJI USB 驱动。</p><div class=\"ds-checkpoints\"><span>环境需要设置</span><span>眼镜未连接</span><span>视频未开始</span></div></section>",
      "css": ".ds-readiness {font-family:\"Microsoft YaHei UI\",\"Segoe UI\",sans-serif;font-size:13px;color:#20363c;background:#e9f1ed;border:1px solid #ccded6;border-radius:10px;padding:18px 22px;display:grid;gap:12px}.ds-status {color:#815414;font-size:20px;font-weight:600;margin:0}.ds-detail {color:#526a70;margin:0}.ds-checkpoints {display:grid;grid-template-columns:repeat(3,1fr);color:#526a70;font-size:12px;gap:12px}"
    },
    {
      "name": "Transport Statistics",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Three equally sized columns show PC-side metrics. Dashes are placeholders until worker events arrive; this is not end-to-end latency.",
      "html": "<section class=\"ds-stat-panel\"><h3 class=\"ds-stat-heading\">当前串流</h3><div class=\"ds-stat-grid\"><div><div class=\"ds-stat-value\">— fps</div><div class=\"ds-stat-label\">发送速率</div></div><div><div class=\"ds-stat-value\">— ms</div><div class=\"ds-stat-label\">USB 发送 p95</div></div><div><div class=\"ds-stat-value\">— ms</div><div class=\"ds-stat-label\">队列等待 p95</div></div></div><p class=\"ds-stat-note\">以上为电脑端统计，并非端到端显示延迟。每 5 秒更新。</p></section>",
      "css": ".ds-stat-panel {font-family:\"Microsoft YaHei UI\",\"Segoe UI\",sans-serif;font-size:13px;color:#20363c;background:#fff;border:1px solid #d7e1de;border-radius:10px;padding:18px 22px;display:grid;gap:12px}.ds-stat-heading {font-size:16px;font-weight:600;margin:0}.ds-stat-grid {display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.ds-stat-value {color:#174f57;font-size:21px;font-weight:600}.ds-stat-label,.ds-stat-note {color:#526a70;font-size:12px}.ds-stat-label {margin-top:8px}.ds-stat-note {margin:0}"
    }
  ],
  "narrative": {
    "northStar": "The Connection Field Guide",
    "overview": "A calm connection workspace pairs a deep petrol navigation rail with warm white\nworking surfaces. The field-guide character comes from aligned information,\nclear route markers, restrained color, and readable Chinese copy. Device\nreadiness leads to one useful action; status is evidence rather than decoration.\n\nThis documents the built Windows/PySide6 0.0.1 interface in Operate mode. The\nvisual language is an implementation decision made under the user's delegated\nauthority, not a claim that the user selected a brand identity. The direction\ncontract is `.impeccable/surfaces/desktop.md`; source values and behavior come\nfrom `desktop_app/ui.py` and `desktop_app/assets/help.html`. The token frontmatter\nis normative for new screens; native Qt behavior remains authoritative.",
    "keyCharacteristics": [
      "Deep petrol navigation and a quiet, light workspace.",
      "Native controls, Chinese-first copy, and visible keyboard focus.",
      "Flat bordered panels, aligned settings, and persistent transport actions.",
      "Evidence-backed status text with semantic title colors."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Change readiness copy only in response to real controller results. The shipped three checkpoints use muted text; semantic color is applied to the status title. Do not describe the checkpoints as colored indicators.",
        "section": "colors"
      },
      {
        "name": "The Native Legibility Rule",
        "body": "Retain system font fallback and text wrapping; never use display typography that makes device details or recovery steps harder to read.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep the footer action aligned with the next executable recovery or streaming step.",
      "Do preserve native keyboard operation, visible focus, label associations, and readable disabled values.",
      "Do keep status and metrics tied to controller evidence and explain their measurement limits.",
      "Do retain the original icon and chevron provenance when packaging or reusing them.",
      "Do verify additions at the minimum window size and allow page content to scroll above the persistent footer."
    ],
    "donts": [
      "Don't imply successful hardware checks through decorative success colors or fabricated values.",
      "Don't show unsupported resolutions, window capture, or an extended desktop as available choices.",
      "Don't introduce a decorative font, shadow system, or animated elevation into the native Operate interface without a new design decision.",
      "Don't replace informative disabled controls with unexplained empty areas or remove their labels.",
      "Don't present the original goggles mark as DJI branding or remove the independent-project notice."
    ]
  }
}
